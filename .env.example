# Used only by exporter/export_gantt.py. The browser extension needs no configuration file.
# Copy to .env and fill in. Never commit .env.

# Base URL of your Plane instance, without a trailing slash
PLANE_BASE_URL=https://plane.example.com
# Personal API token: Plane > Profile settings > API tokens
PLANE_API_KEY=plane_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Workspace slug: the first path segment of your Plane URLs (https://plane.example.com/<slug>/...)
PLANE_WORKSPACE=my-workspace
